{
    "name":  "@kage/db",
    "version":  "0.1.0",
    "private":  true,
    "main":  "./src/index.ts",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  "./src/index.ts"
                },
    "scripts":  {
                    "build":  "tsc",
                    "typecheck":  "tsc --noEmit",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:push":  "drizzle-kit push",
                    "db:studio":  "drizzle-kit studio",
                    "db:seed":  "tsx src/seed.ts",
                    "clean":  "rm -rf dist node_modules",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "@kage/shared":  "*",
                         "drizzle-orm":  "^0.44.0",
                         "postgres":  "^3.4.5"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.15.3",
                            "drizzle-kit":  "^0.31.0",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.8.3",
                            "vitest":  "^3.2.4"
                        }
}
