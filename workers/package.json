{
  "name": "@kage/workers",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./processors/research": {
      "types": "./src/processors/research.ts",
      "default": "./src/processors/research.ts"
    },
    "./processors/outreach": {
      "types": "./src/processors/outreach.ts",
      "default": "./src/processors/outreach.ts"
    },
    "./processors/send-email": {
      "types": "./src/processors/send-email.ts",
      "default": "./src/processors/send-email.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@kage/ai": "*",
    "@kage/config": "*",
    "@kage/db": "*",
    "@kage/gmail": "*",
    "@kage/queue": "*",
    "@kage/research": "*",
    "@kage/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
